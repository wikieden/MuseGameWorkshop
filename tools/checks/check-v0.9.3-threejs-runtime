browser_tests = [
    path
    for path in PROJECT.rglob("*.ts")
    if path.name != "simulation.test.ts"
    and ("test" in path.parts or "e2e" in path.parts)
    and "page.goto" in path.read_text(encoding="utf-8")
]
if not browser_tests:
    fail("missing Playwright browser test with page.goto")

node_modules = PROJECT / "node_modules"
if not node_modules.is_dir():
    print(f"INFO {CHECK}: runtime tests skipped; dependencies are not installed")
else:
    npm = shutil.which("npm")
    node = shutil.which("node")
    if not npm or not node:
        fail("node_modules exists but npm or node is unavailable")

    run_required([npm, "test"], "npm unit tests")
    run_required([npm, "run", "build"], "npm production build")

    browser_probe = subprocess.run(
        [
            node,
            "--input-type=module",
            "-e",
            (
                "import { chromium } from '@playwright/test';"
                "import { existsSync } from 'node:fs';"
                "process.exit(existsSync(chromium.executablePath()) ? 0 : 2);"
            ),
        ],
        cwd=str(PROJECT),
        text=True,
        capture_output=True,
        check=False,
    )
    if browser_probe.returncode == 0:
        run_required([npm, "run", "test:e2e"], "Playwright browser tests", timeout=240)
    elif browser_probe.returncode == 2:
        print(f"INFO {CHECK}: browser tests skipped; configured Playwright browser is unavailable")
    else:
        detail = (browser_probe.stderr.strip() or browser_probe.stdout.strip() or "browser probe failed")[-800:]
        fail(f"installed Playwright dependency is broken: {detail}")

print(f"PASS {CHECK}")
