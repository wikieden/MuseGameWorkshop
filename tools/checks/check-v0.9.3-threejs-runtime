#!/usr/bin/env python3
from pathlib import Path
import json
import shutil
import subprocess
import sys

ROOT = Path(__file__).resolve().parents[2]
PROJECT = ROOT / "examples" / "threejs-boss-rush"
CHECK = "check-v0.9.3-threejs-runtime"


def fail(reason: str) -> None:
    print(f"FAIL {CHECK}: {reason}")
    sys.exit(1)


def require_tokens(rel: str, tokens: list[str]) -> str:
    path = ROOT / rel
    if not path.is_file():
        fail(f"missing {rel}")
    text = path.read_text(encoding="utf-8")
    for token in tokens:
        if token not in text:
            fail(f"{rel} missing {token}")
    return text


def run_required(command: list[str], label: str, timeout: int = 180) -> None:
    try:
        result = subprocess.run(
            command,
            cwd=str(PROJECT),
            text=True,
            capture_output=True,
            check=False,
            timeout=timeout,
        )
    except subprocess.TimeoutExpired:
        fail(f"{label} timed out after {timeout} seconds")
    if result.returncode != 0:
        detail = (result.stderr.strip() or result.stdout.strip() or f"exit {result.returncode}")[-1200:]
        fail(f"{label} failed: {detail}")
    print(f"INFO {CHECK}: {label} passed")


