#!/usr/bin/env python3
from pathlib import Path
import sys

ROOT = Path(__file__).resolve().parents[2]
CHECK = "check-doc-pairs"


def fail(reason: str) -> None:
    print(f"FAIL {CHECK}: {reason}")
    sys.exit(1)


required_pairs = [
    ("README.zh.md", "README.en.md"),
    ("docs/muse-game-workshop-plan.zh.md", "docs/muse-game-workshop-plan.en.md"),
    ("docs/muse-game-workshop-docs/vision.zh.md", "docs/muse-game-workshop-docs/vision.en.md"),
    ("docs/muse-game-workshop-docs/prd.zh.md", "docs/muse-game-workshop-docs/prd.en.md"),
    ("docs/muse-game-workshop-docs/technical-architecture.zh.md", "docs/muse-game-workshop-docs/technical-architecture.en.md"),
    ("docs/muse-game-workshop-docs/godot-unreal-workflow.zh.md", "docs/muse-game-workshop-docs/godot-unreal-workflow.en.md"),
    ("docs/muse-game-workshop-docs/skill-pack-spec.zh.md", "docs/muse-game-workshop-docs/skill-pack-spec.en.md"),
    ("docs/muse-game-workshop-docs/production-language-guide.zh.md", "docs/muse-game-workshop-docs/production-language-guide.en.md"),
    ("docs/muse-game-workshop-docs/bilingual-audience-strategy.zh.md", "docs/muse-game-workshop-docs/bilingual-audience-strategy.en.md"),
    ("docs/muse-game-workshop-docs/terminology-glossary.zh.md", "docs/muse-game-workshop-docs/terminology-glossary.en.md"),
    ("docs/muse-game-workshop-docs/handoff-contracts.zh.md", "docs/muse-game-workshop-docs/handoff-contracts.en.md"),
    ("docs/muse-game-workshop-docs/templates.zh.md", "docs/muse-game-workshop-docs/templates.en.md"),
    ("docs/muse-game-workshop-docs/delivery-plan.zh.md", "docs/muse-game-workshop-docs/delivery-plan.en.md"),
    ("docs/muse-game-workshop-docs/v0.1-execution-plan.zh.md", "docs/muse-game-workshop-docs/v0.1-execution-plan.en.md"),
    ("docs/muse-game-workshop-docs/p0-skill-skeleton-plan.zh.md", "docs/muse-game-workshop-docs/p0-skill-skeleton-plan.en.md"),
    ("docs/muse-game-workshop-docs/v0.1-manifest.zh.md", "docs/muse-game-workshop-docs/v0.1-manifest.en.md"),
    ("docs/muse-game-workshop-docs/testing-strategy.zh.md", "docs/muse-game-workshop-docs/testing-strategy.en.md"),
    ("docs/muse-game-workshop-docs/mvp-roadmap.zh.md", "docs/muse-game-workshop-docs/mvp-roadmap.en.md"),
]

missing = []
if not (ROOT / "README.md").exists():
    missing.append("README.md")

for zh, en in required_pairs:
    if not (ROOT / zh).exists():
        missing.append(zh)
    if not (ROOT / en).exists():
        missing.append(en)

if missing:
    fail("missing " + ", ".join(missing))

print(f"PASS {CHECK}")
