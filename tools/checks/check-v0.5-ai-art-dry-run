#!/usr/bin/env python3
from pathlib import Path
import sys

ROOT = Path(__file__).resolve().parents[2]
CHECK = "check-v0.5-ai-art-dry-run"


def fail(reason: str) -> None:
    print(f"FAIL {CHECK}: {reason}")
    sys.exit(1)


required = [
    "docs/muse-game-workshop-docs/ai-art-asset-pipeline.zh.md",
    "docs/muse-game-workshop-docs/ai-art-asset-pipeline.en.md",
    "docs/evidence/v0.5/boss-rush-ai-art-dry-run-design.zh.md",
    "docs/evidence/v0.5/boss-rush-ai-art-dry-run-review-gate.zh.md",
    "docs/evidence/v0.5/boss-rush-ai-art-direction.zh.md",
    "docs/evidence/v0.5/boss-rush-ai-art-asset-list.zh.md",
    "docs/evidence/v0.5/boss-silhouette-asset-brief.zh.md",
    "docs/evidence/v0.5/arena-moodboard-asset-brief.zh.md",
    "docs/evidence/v0.5/counter-vfx-asset-brief.zh.md",
    "docs/evidence/v0.5/hud-icon-asset-brief.zh.md",
    "docs/evidence/v0.5/store-capsule-draft-asset-brief.zh.md",
    "docs/evidence/v0.5/boss-rush-ai-art-provenance-plan.zh.md",
    "docs/evidence/v0.5/boss-rush-ai-art-review.zh.md",
]

for rel in required:
    if not (ROOT / rel).exists():
        fail(f"missing {rel}")

gate = (ROOT / "docs/evidence/v0.5/boss-rush-ai-art-dry-run-review-gate.zh.md").read_text(encoding="utf-8")
if "Review Status: Approved" not in gate:
    fail("v0.5 review gate is not approved")
if "does not approve new generated art files" not in gate:
    fail("v0.5 review gate does not block generated art files")

asset_ids = ["BR-AIART-001", "BR-AIART-002", "BR-AIART-003", "BR-AIART-004", "BR-AIART-005"]
combined = "\n".join((ROOT / rel).read_text(encoding="utf-8") for rel in required)
for asset_id in asset_ids:
    if asset_id not in combined:
        fail(f"missing asset id {asset_id}")

briefs = [
    "docs/evidence/v0.5/boss-silhouette-asset-brief.zh.md",
    "docs/evidence/v0.5/arena-moodboard-asset-brief.zh.md",
    "docs/evidence/v0.5/counter-vfx-asset-brief.zh.md",
    "docs/evidence/v0.5/hud-icon-asset-brief.zh.md",
    "docs/evidence/v0.5/store-capsule-draft-asset-brief.zh.md",
]
brief_terms = [
    "## 5. AI Use Boundary",
    "## 6. Provenance Requirements",
    "## 7. Review Criteria",
    "## 8.",
]
for rel in briefs:
    text = (ROOT / rel).read_text(encoding="utf-8")
    if "## 2." not in text or "Purpose" not in text:
        fail(f"{rel} missing purpose section")
    for term in brief_terms:
        if term not in text:
            fail(f"{rel} missing {term}")
    if "release-candidate" in text and "Target State: `release-candidate`" in text:
        fail(f"{rel} incorrectly targets release-candidate")

provenance = (ROOT / "docs/evidence/v0.5/boss-rush-ai-art-provenance-plan.zh.md").read_text(encoding="utf-8")
for term in ["Tool", "Model/service", "Prompt", "Output license", "Human edits", "Disclosure risk"]:
    if term not in provenance:
        fail(f"provenance plan missing {term}")
if "No candidate generated" not in provenance:
    fail("provenance plan should state no candidates were generated")

review = (ROOT / "docs/evidence/v0.5/boss-rush-ai-art-review.zh.md").read_text(encoding="utf-8")
if "No asset is approved as `reviewed` or `release-candidate`" not in review:
    fail("review should block reviewed/release-candidate state")
if "planning only" not in review:
    fail("review should be planning only")

for forbidden in ["*.uasset", "*.umap"]:
    for path in (ROOT / "docs/evidence/v0.5").glob(f"**/{forbidden}"):
        fail(f"unexpected binary unreal asset evidence {path.relative_to(ROOT)}")

print(f"PASS {CHECK}")
