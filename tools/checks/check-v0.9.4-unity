for rel, tokens in evidence_contracts.items():
    require_tokens(rel, tokens)

unity_editor = find_unity_editor()
if not unity_editor:
    print(f"INFO {CHECK}: Unity Editor unavailable; editor smoke remains BLOCKED")
else:
    print(f"INFO {CHECK}: Unity Editor found at {unity_editor}")
    with tempfile.TemporaryDirectory(prefix="muse-unity-smoke-") as temp_dir:
        project = Path(temp_dir) / "UnitySmokeProject"
        try:
            smoke = subprocess.run(
                [
                    unity_editor,
                    "-batchmode",
                    "-nographics",
                    "-createProject",
                    str(project),
                    "-quit",
                    "-logFile",
                    "-",
                ],
                text=True,
                capture_output=True,
                check=False,
                timeout=240,
            )
        except subprocess.TimeoutExpired:
            fail("Unity Editor smoke timed out after 240 seconds")
        if smoke.returncode != 0:
            detail = (smoke.stderr.strip() or smoke.stdout.strip() or f"exit {smoke.returncode}")[-1600:]
            fail(f"Unity Editor smoke failed: {detail}")
        combined = f"{smoke.stdout}\n{smoke.stderr}"
        blocking_markers = ["compilation failed", "batchmode quit unexpectedly", "fatal error"]
        for marker in blocking_markers:
            if marker in combined.lower():
                fail(f"Unity Editor smoke reported {marker}")
        print(f"INFO {CHECK}: Unity Editor batchmode create-project smoke passed")

print(f"PASS {CHECK}")
