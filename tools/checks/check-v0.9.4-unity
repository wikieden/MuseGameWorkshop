)

evidence_contracts = {
    "docs/evidence/v0.9.4/v0.9.4-unity-evidence.en.md": [
        "Version: v0.9.4",
        "Language: English",
        "Review Status: Approved",
        "Workflow Support Status:",
        "Unity Editor Validation Status: Blocked - Unity Editor not installed",
        "check-v0.9.4-unity",
    ],
    "docs/evidence/v0.9.4/v0.9.4-unity-evidence.zh.md": [
        "Version: v0.9.4",
        "Language: Chinese",
        "Review Status: Approved",
        "Workflow Support Status:",
        "Unity Editor Validation Status: Blocked - Unity Editor not installed",
        "check-v0.9.4-unity",
    ],
    "docs/evidence/v0.9.4/v0.9.4-unity-review-gate.en.md": [
        "Version: v0.9.4",
