#!/usr/bin/env python3
from pathlib import Path
import glob
import shutil
import subprocess
import sys
import tempfile

ROOT = Path(__file__).resolve().parents[2]
CHECK = "check-v0.9.4-unity"


def fail(reason: str) -> None:
    print(f"FAIL {CHECK}: {reason}")
    sys.exit(1)


def require_tokens(rel: str, tokens: list[str]) -> str:
    path = ROOT / rel
    if not path.is_file():
        fail(f"missing {rel}")
    text = path.read_text(encoding="utf-8")
    for token in tokens:
        if token not in text:
            fail(f"{rel} missing {token}")
    return text


def find_unity_editor() -> str | None:
    for command in ["Unity", "unity-editor", "unity"]:
        resolved = shutil.which(command)
        if resolved:
            return resolved

    patterns = [
        "/Applications/Unity/Hub/Editor/*/Unity.app/Contents/MacOS/Unity",
        str(Path.home() / "Applications/Unity/Hub/Editor/*/Unity.app/Contents/MacOS/Unity"),
        "/opt/unity/editors/*/Editor/Unity",
        "/opt/Unity/Editor/Unity",
        "C:/Program Files/Unity/Hub/Editor/*/Editor/Unity.exe",
    ]
    candidates: list[str] = []
    for pattern in patterns:
        candidates.extend(path for path in glob.glob(pattern) if Path(path).is_file())
    return sorted(candidates, reverse=True)[0] if candidates else None


document_contracts = {
    "docs/muse-game-workshop-docs/production-target-contract.en.md": [
        "Production Target Contract",
